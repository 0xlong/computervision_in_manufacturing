{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-inspection-pilot-lab:gemma-trial:1",
  "title": "Isolated hosted Gemma image/JSON feasibility trial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "model_ids",
    "reference_count",
    "probe_count",
    "max_requests_per_model",
    "reserved_input_tokens_per_request",
    "max_output_tokens",
    "max_runtime_seconds",
    "minimum_interval_seconds",
    "thinking_level",
    "prompt"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "purpose": {
      "const": "normal_preparation_trial_not_defect_evaluation"
    },
    "model_ids": {
      "const": [
        "gemma-4-26b-a4b-it",
        "gemma-4-31b-it"
      ]
    },
    "reference_count": {
      "type": "integer",
      "const": 1
    },
    "probe_count": {
      "type": "integer",
      "const": 2
    },
    "max_requests_per_model": {
      "const": 3
    },
    "reserved_input_tokens_per_request": {
      "const": 4096
    },
    "max_output_tokens": {
      "type": "integer",
      "const": 2048
    },
    "max_runtime_seconds": {
      "type": "integer",
      "const": 600
    },
    "minimum_interval_seconds": {
      "const": 60
    },
    "thinking_level": {
      "const": "minimal"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
