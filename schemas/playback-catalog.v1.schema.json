{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-inspection-pilot-lab:playback-catalog:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "manifest_sha256",
    "images"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "urn:ai-inspection-pilot-lab:fastener-bundle:2#/properties/images/items"
      }
    }
  }
}
