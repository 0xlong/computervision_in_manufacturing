{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-inspection-pilot-lab:api-evidence:1",
  "title": "Offline API evidence snapshot (not a release bundle)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_status", "run", "predictions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "evidence_status": {"enum": ["fixture", "development_only"]},
    "run": {"$ref": "#/$defs/run"},
    "predictions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prediction"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
    "id": {"type": "string", "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])"},
    "image_id": {"type": "string", "pattern": "^img-[0-9]{6}$(?![\\s\\S])"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$(?![\\s\\S])"},
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "observation"],
      "properties": {
        "decision": {"enum": ["looks_acceptable", "needs_review", "uncertain"]},
        "observation": {"type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "track_id", "provider", "model_id", "created_at", "state", "hashes", "inputs", "capabilities", "policy", "request_timeout_seconds", "max_attempts"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "track_id": {"enum": ["fasteners", "metal_surfaces"]},
        "provider": {"const": "gemini"},
        "model_id": {"$ref": "#/$defs/id"},
        "created_at": {"$ref": "#/$defs/utc"},
        "state": {"enum": ["in_progress", "paused", "stopped", "complete"]},
        "hashes": {
          "type": "object", "additionalProperties": false,
          "required": ["manifest", "split", "inputs", "configuration", "preparation", "references", "prompt", "response_schema"],
          "properties": {
            "manifest": {"$ref": "#/$defs/hash"}, "split": {"$ref": "#/$defs/hash"},
            "inputs": {"$ref": "#/$defs/hash"}, "configuration": {"$ref": "#/$defs/hash"},
            "preparation": {"$ref": "#/$defs/hash"}, "references": {"$ref": "#/$defs/hash"},
            "prompt": {"$ref": "#/$defs/hash"}, "response_schema": {"$ref": "#/$defs/hash"}
          }
        },
        "inputs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["image_id", "sha256"],
            "properties": {"image_id": {"$ref": "#/$defs/image_id"}, "sha256": {"$ref": "#/$defs/hash"}}
          }
        },
        "capabilities": {"const": {"categorical_decision": true, "heatmap": false, "adjustable_sensitivity": false, "calibrated_probability": false}},
        "policy": {"const": "fixed_categorical_review_uncertain_and_failures"},
        "request_timeout_seconds": {"type": "integer", "const": 60},
        "max_attempts": {"type": "integer", "const": 3}
      }
    },
    "status": {"enum": ["success", "refusal", "invalid_response", "timeout", "provider_error", "unknown_outcome"]},
    "reason": {"enum": ["none", "refusal", "schema", "timeout", "transport", "server_5xx", "quota", "authentication", "entitlement", "other_provider", "interrupted"]},
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "started_at", "finished_at", "latency_ms", "status", "reason", "reported_model_version", "usage", "response_sha256", "response", "retry_not_before"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 3},
        "started_at": {"$ref": "#/$defs/utc"},
        "finished_at": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
        "latency_ms": {"type": ["number", "null"], "minimum": 0, "maximum": 60000},
        "status": {"$ref": "#/$defs/status"}, "reason": {"$ref": "#/$defs/reason"},
        "reported_model_version": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "usage": {
          "anyOf": [{"type": "null"}, {
            "type": "object", "additionalProperties": false,
            "required": ["input_tokens", "output_tokens"],
            "properties": {
              "input_tokens": {"type": ["integer", "null"], "minimum": 0},
              "output_tokens": {"type": ["integer", "null"], "minimum": 0}
            }
          }]
        },
        "response_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "response": {"anyOf": [{"$ref": "#/$defs/response"}, {"type": "null"}]},
        "retry_not_before": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]}
      }
    },
    "prediction": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "image_id", "request_sha256", "execution_state", "status", "attempts"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"}, "image_id": {"$ref": "#/$defs/image_id"},
        "request_sha256": {"$ref": "#/$defs/hash"},
        "execution_state": {"enum": ["pending", "quota_paused", "terminal"]},
        "status": {"anyOf": [{"$ref": "#/$defs/status"}, {"type": "null"}]},
        "attempts": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}}
      }
    },
    "access": {
      "description": "Caller-supplied nonsecret evidence; validation alone does not authenticate these claims.",
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model_id", "evidence_sha256", "verified_at", "valid_until", "free_execution_verified", "paid_execution_disabled", "terms_and_data_use_verified", "requests_per_minute", "input_tokens_per_minute", "requests_per_day", "remaining_requests_today"],
      "properties": {
        "provider": {"const": "gemini"}, "model_id": {"$ref": "#/$defs/id"},
        "evidence_sha256": {"$ref": "#/$defs/hash"},
        "verified_at": {"$ref": "#/$defs/utc"}, "valid_until": {"$ref": "#/$defs/utc"},
        "free_execution_verified": {"const": true}, "paid_execution_disabled": {"const": true},
        "terms_and_data_use_verified": {"const": true},
        "requests_per_minute": {"type": "integer", "minimum": 1},
        "input_tokens_per_minute": {"type": "integer", "minimum": 1},
        "requests_per_day": {"type": "integer", "minimum": 1},
        "remaining_requests_today": {"type": "integer", "minimum": 1}
      }
    }
  }
}
